# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
GUILD_ID=
# Channel where /submit entries are posted (members react with a thumbs up)
SUBMIT_CHANNEL_ID=
# Staff-only channel: pick announcements during the veto window, errors
STAFF_CHANNEL_ID=
# Public channel for the weekly winner announcement
ANNOUNCE_CHANNEL_ID=
# Optional: archive of past winners
HALL_CHANNEL_ID=

# AI scoring (any OpenAI-compatible chat completions endpoint).
# Leave AI_API_KEY empty to rank by reactions only.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional moderation endpoint (OpenAI-style /v1/moderations). Empty = skip.
MODERATION_URL=
REACTION_WEIGHT=0.2

# Schedule (local time in TIMEZONE). Weekday: Monday=0 ... Sunday=6
TIMEZONE=America/Los_Angeles
CYCLE_WEEKDAY=6
CYCLE_HOUR=20
# Hours between the pick and it going live; staff can /sotw_veto in this window
VETO_HOURS=12

# Submission rules
MIN_ACCOUNT_AGE_DAYS=14
MIN_MEMBER_DAYS=3
MAX_ENTRIES_PER_WEEK=2
LINK_HOSTS=discord.com,discordapp.com,cdn.discordapp.com,youtube.com,youtu.be,imgur.com,i.imgur.com,forums.eqfreelance.net
BLOCKED_WORDS=

# Published data and the small HTTP endpoint the client or a script reads
DATA_DIR=./data
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765
